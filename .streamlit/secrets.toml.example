# Streamlit Cloud Secrets 配置模板
# 使用方法：
#   1. 本地开发：复制此文件为 .streamlit/secrets.toml，填入真实值（已被 .gitignore 忽略）
#   2. Streamlit Cloud 部署：在 App Settings > Secrets 中粘贴以下内容并填入真实值

# ---- OpenAlex（免费，填邮箱即可进入 Polite Pool，提高请求速率）----
OPENALEX_MAILTO = "your_email@example.com"

# ---- Semantic Scholar API Key（可选，免费申请，提高请求速率上限）----
# 申请地址：https://www.semanticscholar.org/product/api
S2_API_KEY = ""

# ---- 翻译 LLM（用于将英文摘要翻译为中文）----
# 支持任何 OpenAI 兼容接口，例如 OpenAI、DeepSeek、通义千问等
LLM_API_BASE = "https://api.openai.com/v1"
LLM_API_KEY = "sk-..."
LLM_MODEL = "gpt-4o-mini"

# ---- 分析 LLM（用于生成综述、洞察、相关性评分，建议使用更强的模型）----
ANALYSIS_LLM_API_BASE = "https://api.openai.com/v1"
ANALYSIS_LLM_API_KEY = "sk-..."
ANALYSIS_LLM_MODEL = "gpt-4o"
